# Exact frontend origin, e.g. https://gym-pose-detection-system.vercel.app
POSE_WEB_ORIGINS=http://localhost:5173

# Directory containing artifacts/fitness_aqa_... subdirectories.
POSE_MODEL_ROOT=.

# Never set to 1 unless this server contains YOUR OWN trusted pickle files.
# Do NOT load joblib artifacts sent by website users.
POSE_TRUST_LOCAL_ARTIFACTS=0
